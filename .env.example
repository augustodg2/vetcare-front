# Endereço da API do VetCare (back-end).
VITE_API_URL=http://localhost:3000

# Liga o MSW (API simulada no navegador). Use "true" para trabalhar sem o back-end.
VITE_ENABLE_MSW=false

# Dados da clínica no cabeçalho do receituário impresso.
VITE_CLINIC_NAME=VetCare
VITE_CLINIC_CNPJ=
VITE_CLINIC_ADDRESS=
VITE_CLINIC_CITY=
VITE_CLINIC_PHONE=
